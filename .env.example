# Copy to .env and adjust. Required values are marked (MONGODB_URI only).

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Frontends (used for CORS + links in emails)
CUSTOMER_APP_URL=http://localhost:5173
PARTNER_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# (M) MongoDB connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/bookmywarehouse_dev

# Auth secrets — MUST be >= 32 chars in production (dev fallbacks exist)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Email: resend | none  ("none" logs emails to the console)
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=BookMyWarehouse <no-reply@bookmywarehouse.dev>

# Payments: SANDBOX | RAZORPAY | STRIPE (only SANDBOX works without keys)
PAYMENT_PROVIDER=SANDBOX
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Image storage — inline dev storage when unset
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed (`pnpm --filter @bmw/api seed`)
# Demo content (demo users, listings, bookings, reviews) is seeded by default
# whenever NODE_ENV != production; production seeds reference data only
# (categories + platform settings + admin bootstrap). Set SEED_DEMO=true to
# include demo content when running with NODE_ENV=production.
SEED_DEMO=
# Admin bootstrap — runs in every mode when both are set (password >= 12 chars):
# creates or updates a verified ADMIN account for SEED_ADMIN_EMAIL.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info
TRUST_PROXY=false

# Rate limits (defaults are production-safe: 300/min API, 20 auth per 15 min/IP).
# Raise for local dev / E2E so repeated runs are not throttled.
RATE_LIMIT_API_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_WINDOW_MIN=
RATE_LIMIT_SENSITIVE_MAX=
MAX_IMAGE_INLINE_BYTES=400000
