{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer": {
      "root": "apps/customer",
      "framework": "vite",
      "buildCommand": "pnpm --filter @bmw/customer build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "destination": "/index.html" }
      ]
    },
    "partner": {
      "root": "apps/partner",
      "framework": "vite",
      "buildCommand": "pnpm --filter @bmw/partner build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/partner", "destination": "/partner/index.html" },
        { "src": "/partner/(.*)", "destination": "/partner/index.html" }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "buildCommand": "pnpm --filter @bmw/admin build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/admin", "destination": "/admin/index.html" },
        { "src": "/admin/(.*)", "destination": "/admin/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "server.js",
      "buildCommand": "pnpm --filter @bmw/api... build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/partner", "destination": { "service": "partner" } },
    { "source": "/partner/(.*)", "destination": { "service": "partner" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "customer" } }
  ]
}
